{
  "description": "Keeps the Spring Tools language server index in sync with files Claude edits, and refreshes it after shell commands that change the working tree.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "mcp_tool",
            "if": "Edit(*.java)",
            "server": "plugin:spring-tools:spring-tools-mcp",
            "tool": "fileChanged",
            "input": {
              "filePath": "${tool_input.file_path}"
            },
            "timeout": 30
          },
          {
            "type": "mcp_tool",
            "if": "Edit(*.kt)",
            "server": "plugin:spring-tools:spring-tools-mcp",
            "tool": "fileChanged",
            "input": {
              "filePath": "${tool_input.file_path}"
            },
            "timeout": 30
          },
          {
            "type": "mcp_tool",
            "if": "Edit(*.kts)",
            "server": "plugin:spring-tools:spring-tools-mcp",
            "tool": "fileChanged",
            "input": {
              "filePath": "${tool_input.file_path}"
            },
            "timeout": 30
          },
          {
            "type": "mcp_tool",
            "if": "Edit(*.groovy)",
            "server": "plugin:spring-tools:spring-tools-mcp",
            "tool": "fileChanged",
            "input": {
              "filePath": "${tool_input.file_path}"
            },
            "timeout": 30
          },
          {
            "type": "mcp_tool",
            "if": "Edit(*.xml)",
            "server": "plugin:spring-tools:spring-tools-mcp",
            "tool": "fileChanged",
            "input": {
              "filePath": "${tool_input.file_path}"
            },
            "timeout": 30
          },
          {
            "type": "mcp_tool",
            "if": "Edit(*.properties)",
            "server": "plugin:spring-tools:spring-tools-mcp",
            "tool": "fileChanged",
            "input": {
              "filePath": "${tool_input.file_path}"
            },
            "timeout": 30
          },
          {
            "type": "mcp_tool",
            "if": "Edit(*.yml)",
            "server": "plugin:spring-tools:spring-tools-mcp",
            "tool": "fileChanged",
            "input": {
              "filePath": "${tool_input.file_path}"
            },
            "timeout": 30
          },
          {
            "type": "mcp_tool",
            "if": "Edit(*.yaml)",
            "server": "plugin:spring-tools:spring-tools-mcp",
            "tool": "fileChanged",
            "input": {
              "filePath": "${tool_input.file_path}"
            },
            "timeout": 30
          },
          {
            "type": "mcp_tool",
            "if": "Edit(*.factories)",
            "server": "plugin:spring-tools:spring-tools-mcp",
            "tool": "fileChanged",
            "input": {
              "filePath": "${tool_input.file_path}"
            },
            "timeout": 30
          },
          {
            "type": "mcp_tool",
            "if": "Edit(*.gradle)",
            "server": "plugin:spring-tools:spring-tools-mcp",
            "tool": "fileChanged",
            "input": {
              "filePath": "${tool_input.file_path}"
            },
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "mcp_tool",
            "if": "Bash(git *)",
            "server": "plugin:spring-tools:spring-tools-mcp",
            "tool": "refreshWorkspace",
            "input": {},
            "timeout": 30
          },
          {
            "type": "mcp_tool",
            "if": "Bash(rm *)",
            "server": "plugin:spring-tools:spring-tools-mcp",
            "tool": "refreshWorkspace",
            "input": {},
            "timeout": 30
          },
          {
            "type": "mcp_tool",
            "if": "PowerShell(git *)",
            "server": "plugin:spring-tools:spring-tools-mcp",
            "tool": "refreshWorkspace",
            "input": {},
            "timeout": 30
          },
          {
            "type": "mcp_tool",
            "if": "PowerShell(Remove-Item *)",
            "server": "plugin:spring-tools:spring-tools-mcp",
            "tool": "refreshWorkspace",
            "input": {},
            "timeout": 30
          }
        ]
      }
    ]
  }
}
